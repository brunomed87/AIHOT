# Configuração do Radar. Copie para .env ou execute scripts/init-env.ts para gerar segredos aleatórios.
# Somente endereço público vai ao navegador. Segredos ficam no backend; não publique .env.

# ===== Obrigatórios =====

# Endereço público usado em links, RSS, imagens e MCP.
SITE_URL=http://localhost:3000

# Senha administrativa, pelo menos doze caracteres; acesso em /admin.
ADMIN_PASSWORD=

# Segredos de sessão e imagens: gere cada um separadamente, por exemplo com openssl rand -hex 32.
SESSION_SECRET=
IMG_PROXY_SIGN_SECRET=

# Senha PostgreSQL no Docker. Banco não expõe porta externa; use valor aleatório.
POSTGRES_PASSWORD=

# Modelo padrão compatível com OpenAI. Exemplo DeepSeek para todas as etapas.
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-flash
# Parâmetros específicos do fornecedor em JSON; exemplo com raciocínio desativado.
LLM_EXTRA_JSON={"thinking":{"type":"disabled"}}
# Outros fornecedores:
# Qwen: LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1 LLM_MODEL=qwen3.8-flash LLM_EXTRA_JSON={"enable_thinking":false}
# Zhipu: LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4 LLM_MODEL=glm-5.3-flash
# Ative visão se o modelo aceitar imagens; primeira imagem complementa título e resumo.
# LLM_VISION=true
# Desative modo JSON se o serviço não aceitar response_format.
# LLM_JSON_MODE=false

# ===== Opcional: melhorar agrupamento =====

# Vetores em serviço compatível com /embeddings. Sem configuração, agrupa com menos evidência.
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small
# Alternativa: chave Alibaba DashScope para text-embedding-v4.
# DASHSCOPE_API_KEY=

# ===== Opcional: modelo por etapa =====
# Cada etapa usa LLM_* por padrão; escolha nome de predefinição com sua chave correspondente.
#   PREFILTER_MODEL  SCORE_MODEL  UNDERSTAND_MODEL  SUMMARIZE_MODEL  STRUCTURE_MODEL
#   GROUP_MODEL  GROUP_REVIEW_MODEL  DIGEST_MODEL  REPORT_MODEL  TRANSLATE_MODEL  MONITOR_MODEL
# Predefinições e chaves:
#   deepseek-flash / deepseek-flash-think        DEEPSEEK_BASE_URL=https://api.deepseek.com/v1  DEEPSEEK_API_KEY=
#   qwen3.7-flash / qwen3.8-flash / qwen3-vl-flash  DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  DASHSCOPE_API_KEY=
#   glm-5.3-flash / glm-5.3-flash-selection     ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4  ZHIPU_API_KEY=
#   mimo-v2.6-flash                             XIAOMI_MIMO_BASE_URL=https://api.xiaomimimo.com/v1  XIAOMI_MIMO_API_KEY=
# Divisão original AIHOT, somente como referência:
#   PREFILTER_MODEL=qwen3.7-flash  SCORE_MODEL=glm-5.3-flash-selection  UNDERSTAND_MODEL=glm-5.3-flash
#   SUMMARIZE_MODEL=deepseek-flash  STRUCTURE_MODEL=qwen3.8-flash  GROUP_MODEL=deepseek-flash
#   GROUP_REVIEW_MODEL=mimo-v2.6-flash  DIGEST_MODEL=deepseek-flash  REPORT_MODEL=deepseek-flash

# ===== Opcional: coleta paga por requisição, com orçamento no painel =====
# X via SocialData; monitor Codex também depende desta chave.
# SOCIALDATA_API_KEY=
# Contas públicas WeChat via Dajiala.
# DAJIALA_KEY=
# Extração alternativa com renderização Jina Reader.
# JINA_API_KEY=
# Chave GitHub somente de leitura para aumentar cota de API.
# GITHUB_TOKEN=
# Artificial Analysis precisa de chave própria para resultados do ranking.
# ARTIFICIAL_ANALYSIS_API_KEY=

# ===== Opcional: Feishu =====
# Envio de selecionados ao grupo: habilite alvo no painel e configure webhook.
FEISHU_CONTENT_PUSH_ENABLED=false
# FEISHU_PUSH_WEBHOOK_URL=
# FEISHU_PUSH_MIRROR_WEBHOOK_URL=
# Alertas e sugestões no grupo interno, com aplicativo Feishu próprio.
FEISHU_INTERNAL_ENABLED=false
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_INTERNAL_CHAT_ID=
# FEISHU_ALERT_CHAT_ID=
# Login Feishu opcional, coexistindo com senha administrativa.
# FEISHU_LOGIN_APP_ID=
# FEISHU_LOGIN_APP_SECRET=
# ADMIN_FEISHU_UNION_IDS=
# ADMIN_EMAILS=

# ===== Outros opcionais =====
# Token de ingestão POST /api/ingest/items, mínimo dezesseis caracteres; ausência desativa acesso.
# INGEST_TOKEN=
# Proxy para coleta de fontes externas quando necessário:
# EGRESS_PROXY_URL=http://127.0.0.1:7890
# Com Caddy ou Nginx confiável, true lê endereço do visitante em X-Forwarded-For.
# Acesso direto: mantenha false para impedir falsificação e desvio dos limites de login e sugestões.
TRUST_PROXY=false
# MCP aceita domínio de SITE_URL e loopback; outros hosts separados por vírgula:
# MCP_ALLOWED_HOSTS=
# Minutos sem conteúdo novo até alertar interrupção, padrão 360:
# ALERT_QUIET_MINUTES=360
# IndexNow envia páginas a buscadores; chave própria com 32 dígitos hexadecimais.
INDEXNOW_SUBMIT_ENABLED=false
# INDEXNOW_KEY=
# Backup diário em armazenamento compatível com S3, como COS, AWS S3 e OSS:
# DB_BACKUP_STORE_SECRET_ID=
# DB_BACKUP_STORE_SECRET_KEY=
# DB_BACKUP_STORE_BUCKET=
# DB_BACKUP_STORE_REGION=
# DB_BACKUP_STORE_DOMAIN=

# ===== Válvulas de segurança =====
# Desativadas para não coletar nem chamar modelos durante avaliação local.
COLLECT_ENABLED=false
MODEL_CALLS_ENABLED=false

# Transporte padrão usa chave de API. chatgpt-plan usa o login local da assinatura no painel.
LLM_TRANSPORT=chat-completions

# ===== Execução local sem Docker =====
# DATABASE_URL=postgres://usuario@127.0.0.1:5432/aihot
# API_BASE_URL=http://127.0.0.1:3001
# Acesso administrativo sem login apenas no desenvolvimento; produção rejeita.
# DEV_AUTH_ROLE=admin

# ===== Perfil HTTPS do Docker Compose =====
# SITE_DOMAIN=example.com

# Radar Oftalmologia Brasil (desativado por padrão durante validação)
OPHTHALMOLOGY_SCOUT_ENABLED=false
OPHTHALMOLOGY_SEARCH_PROVIDERS=europe-pmc
# BRAVE_SEARCH_API_KEY=
# MEDICAL_MODEL=default
